      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "OBA.1.5-6": {
      "text": "Edom will be robbed worse than by thieves",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "OBA.1.7-9": {
      "text": "Allies will betray Edom and its wise men will fall",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "OBA.1.10-11": {
      "text": "Edom will be shamed for standing aside when Jacob suffered",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "OBA.1.12-14": {
      "text": "Edom should not have gloated when Judah was in trouble",
