      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "OBA.1.15-16": {
      "text": "The Day of the LORD is near for all nations",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "OBA.1.17-18": {
      "text": "Zion will be safe, and Edom will be destroyed",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "OBA.1.19-19": {
      "text": "Israel will take the lands of Edom and the Philistines",
