        "suggestion": "Paul urges the Corinthians to imitate him as their father"
      }
    },
    "1CO.4.17-18": {
      "text": "Paul sends Timothy to remind the Corinthians of his ways",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.4.19-21": {
      "text": "Paul will come soon and test the proud people’s power",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.5.1-2": {
      "text": "Paul rebukes the church for allowing a man’s immorality",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.5.3-5": {
      "text": "Paul says the church must hand the man over to Satan",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.5.6-8": {
      "text": "Paul says a little sin spreads, so believers must be pure",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.5.9-10": {
      "text": "Believers need not avoid all sinful people in the world",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.5.11-13": {
      "text": "Believers must not eat with a brother who lives in sin",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.6.1-3": {
      "text": "Paul asks why believers go to court before unbelievers",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.6.4-6": {
      "text": "Paul says believers should settle disputes in the church",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.6.7-8": {
      "text": "Paul says it is better to be wronged than to wrong others",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.6.9-11": {
      "text": "Paul says the wicked will not inherit God’s kingdom",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.6.12-13": {
      "text": "Paul says the body is for the Lord, not immorality",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.6.14-15": {
      "text": "Paul says believers’ bodies are members of Christ",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.6.16-17": {
      "text": "Paul says believers are one with the Lord in spirit",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.6.18-18": {
      "text": "Paul urges believers to flee from sexual immorality",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.6.19-20": {
      "text": "Believers’ bodies belong to God and are his temple",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.7.1-2": {
      "text": "Because of immorality, each person should have a spouse",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.7.3-4": {
      "text": "Husbands and wives belong to each other in marriage",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.7.5-7": {
      "text": "Paul tells married believers not to deprive each other",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.7.8-9": {
      "text": "Unmarried people and widows may stay single or marry",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.7.10-11": {
      "text": "The Lord commands wives and husbands not to divorce",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.7.12-14": {
      "text": "Paul says believers should stay with unbelieving spouses",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.7.15-16": {
      "text": "If an unbeliever leaves, the believer is not bound",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.7.17-19": {
      "text": "Circumcision is nothing; keeping God’s commands counts",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.7.20-24": {
      "text": "Believers should stay in the situation of God’s call",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
