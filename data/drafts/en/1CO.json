  "titles": {
    "1CO.1.4-6": {
      "text": "Paul thanks God for the grace given to the Corinthians",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.1.7-9": {
      "text": "God is faithful and will keep believers to the end",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.1.10-11": {
      "text": "Paul urges the church to agree, because of quarrels",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.1.12-13": {
      "text": "The Corinthians divide by following different leaders",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.1.14-16": {
      "text": "Paul baptized only a few of the Corinthians",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.1.17-17": {
      "text": "Christ sent Paul to preach the gospel, not to baptize",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.1.18-19": {
      "text": "The cross seems foolish to some but is God’s power",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.1.20-21": {
      "text": "God made the world’s wisdom foolish and saves believers",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.1.22-23": {
      "text": "Paul preaches Christ crucified to Jews and Greeks",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.1.24-25": {
      "text": "Christ is God’s power and wisdom for those called",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.1.26-27": {
      "text": "God chose weak and foolish people to shame the strong",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.1.28-29": {
      "text": "God chose lowly people so that no one can boast",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.1.30-31": {
      "text": "Christ is wisdom from God; believers boast in the Lord",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.2.1-2": {
      "text": "Paul came to Corinth preaching only Christ crucified",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.2.3-5": {
      "text": "Paul came in weakness so faith would rest on God’s power",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.2.6-7": {
      "text": "Paul speaks God’s hidden wisdom to the mature",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.2.8-9": {
      "text": "Rulers did not understand and crucified the Lord of glory",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.2.10-11": {
      "text": "God reveals his wisdom to believers by the Spirit",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.2.12-13": {
      "text": "Paul speaks words taught by the Spirit, not by men",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.2.14-16": {
      "text": "People without the Spirit cannot understand God’s things",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.3.1-2": {
      "text": "Paul calls the Corinthians infants who need milk",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.3.3-5": {
      "text": "Jealousy shows the Corinthians are still worldly",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.3.6-7": {
      "text": "Paul planted, Apollos watered, but God made it grow",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.3.8-9": {
      "text": "Paul and Apollos work together for God and are rewarded",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.3.10-11": {
      "text": "Jesus Christ is the foundation; builders must be careful",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.3.12-13": {
      "text": "Fire will test the quality of each builder’s work",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.3.14-15": {
      "text": "Builders whose work survives will receive a reward",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "unreviewed",
      "check": {
        "by": "ai:google/gemini-3.8-flash",
        "verdict": "disagree",
        "criteria": ["covers"],
        "why": "It mentions only work that survives (verse 14) and ignores the builder who suffers loss (verse 15).",
        "suggestion": "Builders will receive a reward or suffer loss"
      }
    },
    "1CO.3.16-17": {
      "text": "The Corinthians are God’s holy temple",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.3.18-20": {
      "text": "Worldly wisdom is foolishness to God",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.3.21-23": {
      "text": "Paul tells believers to stop boasting in men",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.4.1-2": {
      "text": "Paul says God’s stewards must be found faithful",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.4.3-4": {
      "text": "Paul says the Lord, not people, is his judge",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.4.5-5": {
      "text": "Believers should not judge before the Lord comes",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.4.6-7": {
      "text": "Paul tells the Corinthians not to be proud of one man",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.4.8-9": {
      "text": "Paul says apostles are like prisoners facing death",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.4.10-11": {
      "text": "Paul contrasts weak, hungry apostles with wise Corinthians",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.4.12-13": {
      "text": "Paul says apostles bless and endure when mistreated",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "1CO.4.14-16": {
      "text": "Paul is the Corinthians’ father and asks for imitation",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "unreviewed",
      "check": {
        "by": "ai:google/gemini-3.8-flash",
