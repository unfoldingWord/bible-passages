      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "2CO.8.13-15": {
      "text": "Paul wants equality between the Corinthians and others",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "2CO.8.16-17": {
      "text": "Paul thanks God for Titus’s eagerness to help",
