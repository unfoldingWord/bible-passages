      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "2CO.5.11-12": {
      "text": "Paul hopes the Corinthians see that he is sincere",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "2CO.5.13-15": {
      "text": "Christ’s love compels Paul because Christ died for all",
