      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "2CO.4.16-18": {
      "text": "Paul does not lose heart but looks at what is unseen",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "2CO.5.1-3": {
      "text": "Believers will have an eternal house from God in heaven",
