      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "2CO.1.15-16": {
      "text": "Paul planned to visit the Corinthians twice",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "2CO.1.17-18": {
      "text": "Paul did not change his plans carelessly",
