      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "2CO.5.4-5": {
      "text": "God has given believers the Spirit as a promise",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "2CO.5.6-8": {
      "text": "Paul prefers to be at home with the Lord",
