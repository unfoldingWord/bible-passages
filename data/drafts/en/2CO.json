      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "2CO.4.7-10": {
      "text": "Paul is pressed on all sides but not destroyed",
      "source": "ai:anthropic/claude-sonnet-5.5",
      "status": "ai-checked",
      "check": { "by": "ai:google/gemini-3.8-flash", "verdict": "agree" }
    },
    "2CO.4.11-12": {
      "text": "Paul faces death so that life works in the Corinthians",
