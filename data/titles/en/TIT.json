    "TIT.1.1-3": {
      "text": "Paul introduces himself as God’s servant and apostle",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.1.4-4": {
      "text": "Paul greets Titus, his true child in the faith",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.1.5-5": {
      "text": "Paul left Titus in Crete to appoint elders",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.1.6-7": {
      "text": "Elders must be blameless in family and character",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.1.8-9": {
      "text": "Elders must live well and hold to the true message",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.1.10-11": {
      "text": "Rebellious people who mislead households must be silenced",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.1.12-13": {
      "text": "Titus must firmly correct them",
      "status": "human-reviewed",
      "source": "reviewer:timjore"
    },
    "TIT.1.14-14": {
      "text": "Do not follow myths or commands of men",
      "status": "human-reviewed",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.1.15-16": {
      "text": "Some say they know God but their actions deny him",
      "status": "human-reviewed",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.2.1-2": {
      "text": "Titus teaches older men to live with self-control",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.2.3-5": {
      "text": "Older women are to teach the younger women",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.2.6-8": {
      "text": "Titus instructs younger men",
      "status": "human-reviewed",
      "source": "reviewer:timjore"
    },
    "TIT.2.9-10": {
      "text": "Slaves are to be respectful and honest to their masters",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.2.11-13": {
      "text": "God’s grace teaches us to live well as we wait for Christ",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.2.14-14": {
      "text": "Christ gave himself to make a people for himself",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.2.15-15": {
      "text": "Titus must speak with authority",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.3.1-2": {
      "text": "Believers should obey rulers and be gentle to everyone",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.3.3-3": {
      "text": "Before, we were foolish and slaves to our desires",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.3.4-5": {
      "text": "God saved us because of his mercy, not our deeds",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.3.6-7": {
      "text": "God poured out the Spirit so we have hope of eternal life",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.3.8-8": {
      "text": "Believers should be devoted to doing good",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.3.9-11": {
      "text": "Avoid foolish arguments and reject a divisive person",
      "status": "human-reviewed",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.3.12-13": {
      "text": "Paul asks Titus to come and to help Zenas and Apollos",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.3.14-14": {
      "text": "Believers must work to meet urgent needs",
      "status": "ai-checked",
      "source": "ai:claude-sonnet-5-5"
    },
    "TIT.3.15-15": {
      "text": "Final greetings and blessing",
      "status": "human-reviewed",
      "source": "ai:claude-sonnet-5-5"
    }
  }
}
