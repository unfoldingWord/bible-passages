    "1TI.1.1-2": {
      "text": "Paul’s Greeting to Timothy",
      "status": "unreviewed",
      "source": "bsb-1ti"
    },
    "1TI.1.3-4": {
      "text": "Paul tells Timothy to stop false teaching in Ephesus",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.1.5-8": {
      "text": "Paul says the goal is love, but some turn to empty talk",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.1.9-11": {
      "text": "Paul says the law is for the lawless and sinful",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.1.12-14": {
      "text": "Paul thanks Christ Jesus for showing him mercy",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.1.15-17": {
      "text": "Christ Jesus came to save sinners, even Paul",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.1.18-20": {
      "text": "Paul charges Timothy to fight well and keep faith",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.2.1-4": {
      "text": "Paul urges believers to pray for everyone, even kings",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.2.5-7": {
      "text": "There is one God and one mediator, Christ Jesus",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.2.8-8": {
      "text": "Paul wants men everywhere to pray without anger",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.2.9-10": {
      "text": "Paul wants women to dress modestly and do good deeds",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.2.11-12": {
      "text": "Paul says women must learn quietly, not teach or rule men",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.2.13-15": {
      "text": "Paul points to Adam and Eve and to women’s faith",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.3.1-3": {
      "text": "An overseer must be above reproach and of good character",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.3.4-5": {
      "text": "An overseer must manage his own household well",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.3.6-7": {
      "text": "Overseers must not be new believers and must be respected",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.3.8-10": {
      "text": "Deacons must be dignified, honest, and tested first",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.3.11-13": {
      "text": "The women and deacons must be dignified and faithful",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.3.14-15": {
      "text": "Paul writes how believers should act in the church",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.3.16-16": {
      "text": "Christ appeared in the flesh and was taken up in glory",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.4.1-2": {
      "text": "The Spirit says some will leave the faith in later times",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.4.3-5": {
      "text": "False teachers forbid marriage and some foods",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.4.6-8": {
      "text": "Timothy should reject myths and train for godliness",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.4.9-10": {
      "text": "Paul works hard because he hopes in the living God",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.4.11-13": {
      "text": "Timothy must be an example for the believers",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.4.14-16": {
      "text": "Timothy must use his gift and watch his teaching",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.5.1-2": {
      "text": "Reproof and Respect",
      "status": "unreviewed",
      "source": "bsb-1ti"
    },
    "1TI.5.3-4": {
      "text": "Children and grandchildren must care for widows",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.5.5-6": {
      "text": "A widow in need hopes in God and prays day and night",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.5.7-8": {
      "text": "Anyone who does not provide for family denies the faith",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.5.9-10": {
      "text": "Widows over sixty with good deeds may be enrolled",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.5.11-13": {
      "text": "Timothy should not enroll younger widows",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.5.14-16": {
      "text": "Younger widows should marry and manage a home",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.5.17-18": {
      "text": "Elders who lead well deserve double honor",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.5.19-20": {
      "text": "Timothy must be careful with accusations against elders",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.5.21-22": {
      "text": "Paul charges Timothy to be fair and stay pure",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.5.23-25": {
      "text": "Paul tells Timothy to use a little wine",
      "status": "unreviewed",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.6.1-2": {
      "text": "Serving with Honor",
      "status": "unreviewed",
      "source": "bsb-1ti"
    },
    "1TI.6.3-5": {
      "text": "Reject False Doctrines",
      "status": "unreviewed",
      "source": "bsb-1ti"
    },
    "1TI.6.6-8": {
      "text": "Believers should be content with food and clothing",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.6.9-10": {
      "text": "Loving money leads people into ruin and sorrow",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.6.11-12": {
      "text": "Timothy must run from evil and pursue godliness",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.6.13-14": {
      "text": "Paul charges Timothy to keep the commandment",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.6.15-16": {
      "text": "Paul praises God, the only King and Lord",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "1TI.6.17-19": {
      "text": "A Charge to the Rich",
      "status": "unreviewed",
      "source": "bsb-1ti"
    },
    "1TI.6.20-21": {
      "text": "Guard the Faith",
      "status": "unreviewed",
      "source": "bsb-1ti"
    }
  }
}
