    "JAS.1.1-1": {
      "text": "A Greeting from James",
      "status": "unreviewed",
      "source": "bsb-jas"
    },
    "JAS.1.2-3": {
      "text": "James says trials test faith and bring perseverance",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.1.4-5": {
      "text": "James tells believers to ask God for wisdom",
      "status": "unreviewed",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.1.6-8": {
      "text": "Believers must ask God in faith, without doubting",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.1.9-11": {
      "text": "Poor and rich believers should both take pride in God",
      "status": "unreviewed",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.1.12-12": {
      "text": "A person who endures trials will receive the crown of life",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.1.13-13": {
      "text": "God does not tempt anyone to do evil",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.1.14-16": {
      "text": "Evil desires lead to sin and then to death",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.1.17-18": {
      "text": "God gives every good gift and gave us new birth",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.1.19-21": {
      "text": "James tells believers to listen first and accept God’s word",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.1.22-25": {
      "text": "James urges believers to do what the word says",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.1.26-27": {
      "text": "True religion controls the tongue and cares for the needy",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.2.1-4": {
      "text": "James warns believers not to favor rich people",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.2.5-7": {
      "text": "God chose the poor, but the church dishonored them",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.2.8-9": {
      "text": "Favoritism is sin, but loving your neighbor is right",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.2.10-11": {
      "text": "Breaking one part of the law makes a person guilty of all",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.2.12-13": {
      "text": "James tells believers to speak and act with mercy",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.2.14-17": {
      "text": "Faith without deeds is dead",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.2.18-20": {
      "text": "James says faith without deeds is worthless",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.2.21-24": {
      "text": "Abraham’s deeds showed that his faith was real",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.2.25-26": {
      "text": "Rahab’s actions show that faith needs deeds",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.3.1-2": {
      "text": "James warns that teachers will be judged more strictly",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.3.3-4": {
      "text": "James compares the tongue to a horse’s bit and a ship’s rudder",
      "status": "unreviewed",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.3.5-6": {
      "text": "The tongue is a small fire that harms the whole person",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.3.7-8": {
      "text": "No one can tame the tongue, but people tame animals",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.3.9-10": {
      "text": "Believers bless God and curse people with one mouth",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.3.11-12": {
      "text": "A spring cannot give both fresh water and salt water",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.3.13-14": {
      "text": "Wise people show good conduct, not bitter jealousy",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.3.15-18": {
      "text": "Earthly wisdom brings disorder; God’s wisdom brings peace",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.4.1-3": {
      "text": "Wrong desires cause quarrels among believers",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.4.4-5": {
      "text": "Friendship with the world makes believers enemies of God",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.4.6-6": {
      "text": "God gives grace to the humble but opposes the proud",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.4.7-7": {
      "text": "Believers should submit to God and resist the devil",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.4.8-10": {
      "text": "James urges sinners to come near to God and be humble",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.4.11-12": {
      "text": "Believers must not speak against or judge each other",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.4.13-14": {
      "text": "Life is like a mist, and no one knows tomorrow",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.4.15-17": {
      "text": "Believers should plan as the Lord wills and do right",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.5.1-3": {
      "text": "James warns rich people that misery is coming",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.5.4-6": {
      "text": "Rich people cheated workers and lived in luxury",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.5.7-8": {
      "text": "Believers should be patient until the Lord comes",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.5.9-11": {
      "text": "Believers should not complain but be patient like Job",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.5.12-12": {
      "text": "Believers should not swear oaths but speak simply",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.5.13-15": {
      "text": "Believers pray when in trouble; elders pray for the sick",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.5.16-18": {
      "text": "Believers should confess sins and pray like Elijah",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JAS.5.19-20": {
      "text": "Restoring a Sinner",
      "status": "unreviewed",
      "source": "bsb-jas"
    }
  }
}
