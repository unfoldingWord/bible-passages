    "2TI.1.1-2": {
      "text": "Paul’s Greeting to Timothy",
      "status": "unreviewed",
      "source": "bsb-2ti"
    },
    "2TI.1.3-5": {
      "text": "Paul thanks God for Timothy’s sincere faith",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.1.6-7": {
      "text": "Paul urges Timothy to use God’s gift without fear",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.1.8-11": {
      "text": "Timothy must not be ashamed but suffer for the gospel",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.1.12-12": {
      "text": "Paul is not ashamed of suffering because he trusts God",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.1.13-14": {
      "text": "Timothy must hold to sound teaching and guard it",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.1.15-18": {
      "text": "Many left Paul, but Onesiphorus helped him often",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.2.1-2": {
      "text": "Timothy must be strong and train faithful men to teach",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.2.3-5": {
      "text": "Timothy must suffer like a soldier and a competitor",
      "status": "unreviewed",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.2.6-7": {
      "text": "Paul says a hardworking farmer shares the crops first",
      "status": "unreviewed",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.2.8-10": {
      "text": "Paul suffers in chains, but God’s word is not chained",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.2.11-13": {
      "text": "A trusted saying about living and reigning with Christ",
      "status": "unreviewed",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.2.14-15": {
      "text": "Timothy must remind believers not to quarrel over words",
      "status": "unreviewed",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.2.16-18": {
      "text": "Timothy must avoid empty talk and false teachers",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.2.19-21": {
      "text": "Believers who clean themselves are useful to the Master",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.2.22-23": {
      "text": "Timothy must flee youthful passions and pursue peace",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.2.24-26": {
      "text": "The Lord’s servant must be kind and teach gently",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.3.1-4": {
      "text": "In the last days men will be selfish and evil",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.3.5-7": {
      "text": "Timothy must turn away from men who only seem godly",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.3.8-9": {
      "text": "False teachers oppose the truth like Jannes and Jambres",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.3.10-13": {
      "text": "The Lord rescued Paul; godly believers will be persecuted",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.3.14-15": {
      "text": "Timothy must continue in what he learned from Scripture",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.3.16-17": {
      "text": "Scripture is from God and equips believers for good work",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.4.1-2": {
      "text": "Paul charges Timothy to preach the word",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.4.3-5": {
      "text": "Men will reject truth, but Timothy must do his work",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.4.6-8": {
      "text": "Paul has kept the faith and expects a crown",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.4.9-10": {
      "text": "Paul asks Timothy to come quickly; Demas left Paul",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.4.11-13": {
      "text": "Paul asks Timothy to bring Mark, his cloak and scrolls",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.4.14-15": {
      "text": "Paul warns Timothy about Alexander, who harmed Paul",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.4.16-16": {
      "text": "No one stood with Paul at his first defense",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.4.17-18": {
      "text": "The Lord stood by Paul and will rescue him",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TI.4.19-22": {
      "text": "Final Greetings",
      "status": "unreviewed",
      "source": "bsb-2ti"
    }
  }
}
