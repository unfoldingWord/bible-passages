    "ZEP.P.3.1-5": {
      "text": "Judgment on Jerusalem",
      "status": "unreviewed",
      "source": "bsb-zep"
    },
    "ZEP.P.3.6-8": {
      "text": "Purification of the Nations",
      "status": "unreviewed",
      "source": "bsb-zep"
    },
    "ZEP.P.3.9-13": {
      "text": "A Faithful Remnant",
      "status": "unreviewed",
      "source": "bsb-zep"
    },
    "ZEP.P.3.14-20": {
      "text": "Israel’s Restoration",
      "status": "unreviewed",
      "source": "bsb-zep"
    },
    "ZEP.1.1-3": {
      "text": "The LORD says he will sweep away everything on earth",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.1.4-6": {
      "text": "The LORD will punish Judah for worshiping idols",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.1.7-9": {
      "text": "The Day of the LORD is near, and he will punish leaders",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.1.10-11": {
      "text": "Jerusalem will wail and its merchants will be silenced",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.1.12-13": {
      "text": "The LORD will punish people who think he does nothing",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.1.14-16": {
      "text": "The great Day of the LORD will be a day of wrath",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.1.17-18": {
      "text": "Silver and gold cannot save sinners on the LORD’s Day",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.2.1-3": {
      "text": "A Call to Repentance",
      "status": "unreviewed",
      "source": "bsb-zep"
    },
    "ZEP.2.4-5": {
      "text": "The LORD will destroy the Philistine cities",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.2.6-7": {
      "text": "The coast will belong to the remnant of Judah",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.2.8-9": {
      "text": "The LORD will punish Moab and Ammon for insulting Israel",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.2.10-11": {
      "text": "Moab and Ammon will be punished for pride",
      "status": "unreviewed",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.2.12-14": {
      "text": "The LORD will strike Cush and destroy Assyria",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.2.15-15": {
      "text": "Nineveh thought it was safe but became a ruin",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.3.1-2": {
      "text": "Woe to Jerusalem, which does not trust the LORD",
      "status": "unreviewed",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.3.3-4": {
      "text": "Jerusalem’s leaders, prophets and priests are corrupt",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.3.5-5": {
      "text": "The LORD is righteous, but the unjust have no shame",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.3.6-7": {
      "text": "The LORD punished the nations, but Jerusalem did not learn",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.3.8-8": {
      "text": "The LORD will gather nations and pour out his anger",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.3.9-11": {
      "text": "The LORD will purify the peoples and remove the proud",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.3.12-13": {
      "text": "The LORD will leave a humble people who trust him",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.3.14-16": {
      "text": "Zion should sing because the LORD removed punishment",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.3.17-18": {
      "text": "The LORD is mighty to save and rejoices over Zion",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "ZEP.3.19-20": {
      "text": "The LORD will gather the scattered and give Israel fame",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    }
  }
}
