    "2TH.1.1-2": {
      "text": "Paul greets the church in Thessalonica",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.1.3-4": {
      "text": "Paul thanks God for the Thessalonians’ faith and love",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.1.5-5": {
      "text": "Believers’ suffering shows God’s judgment is right",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.1.6-8": {
      "text": "Jesus will punish those who hurt believers",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.1.9-10": {
      "text": "Those who reject God will be destroyed when Jesus comes",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.1.11-12": {
      "text": "Paul prays that God will count believers worthy",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.2.1-2": {
      "text": "Believers should not think the Lord’s Day has come",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.2.3-4": {
      "text": "The man of lawlessness will come before the Lord’s Day",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.2.5-7": {
      "text": "Paul reminds believers what holds back lawlessness",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.2.8-10": {
      "text": "Jesus will destroy the lawless one when he comes",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.2.11-12": {
      "text": "God sends a delusion on those who reject the truth",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.2.13-15": {
      "text": "Believers are chosen by God and must stand firm",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.2.16-17": {
      "text": "Paul prays that God will encourage the believers",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.3.1-3": {
      "text": "Paul asks believers to pray for his work",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.3.4-5": {
      "text": "Paul is confident that believers will obey",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.3.6-9": {
      "text": "Believers must avoid idle brothers and imitate Paul",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.3.10-12": {
      "text": "Paul tells idle believers to work quietly",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.3.13-15": {
      "text": "Believers should keep doing good and warn the disobedient",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "2TH.3.16-18": {
      "text": "Signature and Final Greetings",
      "status": "unreviewed",
      "source": "bsb-2th"
    }
  }
}
