    "JUD.1.3-4": {
      "text": "Jude urges believers to defend the faith from ungodly men",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JUD.1.5-6": {
      "text": "God punished unbelieving Israelites and rebel angels",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JUD.1.7-8": {
      "text": "Sodom and Gomorrah are an example of God’s punishment",
      "status": "unreviewed",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JUD.1.9-11": {
      "text": "Ungodly men slander and follow Cain, Balaam and Korah",
      "status": "human-reviewed",
      "source": "reviewer:maintainer"
    },
    "JUD.1.12-13": {
      "text": "Jude compares the ungodly men to reefs, clouds and waves",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JUD.1.14-16": {
      "text": "Enoch said the Lord will judge the ungodly",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JUD.1.17-19": {
      "text": "The apostles warned believers about scoffers",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JUD.1.20-21": {
      "text": "Jude urges believers to stay in God’s love",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
    "JUD.1.22-23": {
      "text": "Believers should show mercy to doubters and save others",
      "status": "ai-checked",
      "source": "ai:anthropic/claude-sonnet-5.5"
    },
